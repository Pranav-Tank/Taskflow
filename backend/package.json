{
  "name": "taskflow-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/architecture.test.js tests/integration.test.js",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:dev": "prisma migrate dev --config prisma7.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.16.0",
    "joi": "^18.0.0",
    "dotenv": "^17.2.0",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "prisma": "7.10.0"
  }
}
